# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:80,http://localhost

# PostgreSQL Connection URL
# For local development or Contabo VPS:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foxford

# JWT Secret (generate a strong random string in production)
JWT_SECRET=foxford-super-secret-jwt-key-change-in-production-2026

# Admin Credentials for db:init
ADMIN_EMAIL=xudayberganovbackend@gmail.com
ADMIN_PASSWORD=AdminPassword123!

# Telegram Bot Configuration
# 1. Telegram'da @BotFather ga kiring: /newbot yoki mavjud botingiz tokenini oling.
# 2. Tokenni TELEGRAM_BOT_TOKEN ga qo'ying.
# 3. Agar Telegram Login Vidjetidan foydalanmoqchi bo'lsangiz, @BotFather ga /setdomain yuboring va sayt domeningizni kiriting.
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=edu_foxbot
TELEGRAM_BOT_USERNAME=edu_foxbot

