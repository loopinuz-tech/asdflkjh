{
  "name": "foxford-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cd frontend && npx vite preview --host 0.0.0.0 --port ${PORT:-10000}",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "cd frontend && npm run build",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "db:init": "npm run db:init --prefix backend",
    "seed:speaking": "npm run seed:speaking --prefix backend",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
